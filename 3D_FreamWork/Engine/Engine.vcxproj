  <!--
    Assets/シェーダー/PhysX DLLは、EngineとSample2D/Sample3Dの共有出力先($(OutDir))へ
    ここでまとめてコピーする。Engine.libが最新で再リンクされない時でも、Engineのビルドのたびに
    必ず動く(PostBuildEventだとEngineのコードが変わった時しか動かない)。Sample2D/Sample3Dは
    どちらもEngineへのProjectReferenceを持ち、必ずEngineが先にビルドされるため、コピーは
    設定ごとに1回・確実にサンプルより前に完了する(サンプル側に同じ処理を重複させると、
    共有OutDirへ複数のビルドが並行して書き込み合い、まれにファイル共有違反で失敗するため、
    ここに一本化する)。xcopyの /d は新しいファイルだけコピー、/i はコピー先フォルダを作る。
  -->
  <PropertyGroup>
    <PhysXDllDir Condition="'$(Configuration)'=='Debug'">x64-debug</PhysXDllDir>
    <PhysXDllDir Condition="'$(Configuration)'=='Release'">x64-release</PhysXDllDir>
  </PropertyGroup>
  <!--
    VisualStudioのF5は「高速最新チェック」で、ソースが変わっていないEngineのビルドを丸ごと飛ばす
    (飛ばされるとCopyRuntimeFilesも動かない)。Assets/シェーダーを入力に登録しておくと、
    これらを編集した時にEngineが「古い」と判定されてビルドされ、コピーが走る。
  -->
  <ItemGroup>
    <UpToDateCheckInput Include="$(SolutionDir)Assets\**" />
    <UpToDateCheckInput Include="$(SolutionDir)Shader.hlsl" />
    <UpToDateCheckInput Include="$(SolutionDir)Shader3D.hlsl" />
    <UpToDateCheckInput Include="$(SolutionDir)Shader3DSkin.hlsl" />
    <UpToDateCheckInput Include="$(SolutionDir)Shader3DCommon.hlsli" />
    <UpToDateCheckInput Include="$(SolutionDir)Shader3DWater.hlsl" />
  </ItemGroup>
  <Target Name="CopyRuntimeFiles" AfterTargets="Build">
    <Exec Command="xcopy /y /d &quot;$(SolutionDir)..\ThirdParty\PhysX\lib\$(PhysXDllDir)\*.dll&quot; &quot;$(OutDir)&quot;" />
    <Exec Command="xcopy /y /d /e /i &quot;$(SolutionDir)Assets&quot; &quot;$(OutDir)Assets\&quot;" />
    <Exec Command="xcopy /y /d &quot;$(SolutionDir)Shader.hlsl&quot; &quot;$(OutDir)&quot;" />
    <Exec Command="xcopy /y /d &quot;$(SolutionDir)Shader3D.hlsl&quot; &quot;$(OutDir)&quot;" />
    <Exec Command="xcopy /y /d &quot;$(SolutionDir)Shader3DSkin.hlsl&quot; &quot;$(OutDir)&quot;" />
    <Exec Command="xcopy /y /d &quot;$(SolutionDir)Shader3DCommon.hlsli&quot; &quot;$(OutDir)&quot;" />
    <Exec Command="xcopy /y /d &quot;$(SolutionDir)Shader3DWater.hlsl&quot; &quot;$(OutDir)&quot;" />
  </Target>
