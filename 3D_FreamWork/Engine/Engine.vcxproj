      <ConformanceMode>true</ConformanceMode>
      <!-- 複数プロジェクトの並行ビルドでPDB書き込みが衝突しないようにする -->
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <!--
      Assets/シェーダー/PhysX DLLは、EngineとSample2D/Sample3Dの共有出力先($(OutDir))へ
      ここでまとめてコピーする。Sample2D/Sample3DはどちらもEngineへのProjectReferenceを
      持ち、必ずEngineが先にビルドされるため、コピーは設定ごとに1回・確実にサンプルより
      前に完了する(サンプル側に同じ処理を重複させると、共有OutDirへ複数のビルドが並行して
      書き込み合い、まれにファイル共有違反でビルドが失敗することがあるため、ここに一本化する)。
    -->
    <PostBuildEvent>
      <Command>xcopy /y /d "$(SolutionDir)..\ThirdParty\PhysX\lib\x64-debug\*.dll" "$(OutDir)"
xcopy /y /d /e /i "$(SolutionDir)Assets" "$(OutDir)Assets\"
xcopy /y /d "$(SolutionDir)Shader.hlsl" "$(OutDir)"
xcopy /y /d "$(SolutionDir)Shader3D.hlsl" "$(OutDir)"</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
